# Copy to infra/.env and replace the placeholders.
RABBITMQ_DEFAULT_USER=moriarty
RABBITMQ_DEFAULT_PASS=change-me
POSTGRES_USER=moriarty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moriarty
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Used by `holodeck.run` and `ship.relay`; same credentials as above.
AMQP_URL=amqp://moriarty:change-me@localhost:5672/
DATABASE_URL=postgresql://moriarty:change-me@localhost:5432/moriarty
# Provider key for `drive: remote` profiles (profiles/demo.json names it in `key_env`).
ANTHROPIC_API_KEY=your-key-here
# Where `moriarty doctor` looks for Ollama; on WSL2 the Windows host (decisions-m1 4).
OLLAMA_URL=http://localhost:11434
