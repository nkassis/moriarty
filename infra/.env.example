# Copy to infra/.env and replace the placeholders.
RABBITMQ_DEFAULT_USER=moriarty
RABBITMQ_DEFAULT_PASS=change-me
POSTGRES_USER=moriarty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moriarty
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Used by `holodeck.run` and `ship.relay`; same credentials as above.
AMQP_URL=amqp://moriarty:change-me@localhost:5672/
DATABASE_URL=postgresql://moriarty:change-me@localhost:5432/moriarty
